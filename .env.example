# Copy to .env and adjust. All values are optional unless noted.

# Port the container listens on (docker compose only).
PORT=3000

# The single admin account, created automatically on first boot.
ADMIN_USERNAME=admin
ADMIN_NAME=Club Admin
ADMIN_PASSWORD=changeme123

# Seed a demo club (members, games, past months with reviews) into an empty database.
SEED_DEMO=false

# Optional: free key from https://rawg.io/api for live game search in the suggest form.
RAWG_API_KEY=

# Set to true when serving over HTTPS so session cookies are marked Secure.
COOKIE_SECURE=false
